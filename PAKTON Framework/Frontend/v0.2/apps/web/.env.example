# ============================================
# PAKTON Frontend Environment Variables
# ============================================

# ---Local Development Flag---
# Set to "true" when running locally (even in Docker) to use HTTP instead of HTTPS
LOCAL_DEVELOPMENT="true"

# ---Supabase Configuration (Authentication)---
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ---Supabase Configuration (Document Uploads)---
NEXT_PUBLIC_SUPABASE_URL_DOCUMENTS=<your-supabase-url-documents>
NEXT_PUBLIC_SUPABASE_ANON_KEY_DOCUMENTS=<your-supabase-anon-key-documents>

# ---Google OAuth (Optional - for pre-built Google signin)---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-google-client-id>